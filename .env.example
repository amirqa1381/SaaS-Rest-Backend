# Copy this file to .env and adjust as needed. .env is gitignored.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Inside Docker Compose, host is the service name ("postgres"/"redis"),
# not localhost.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/saas_backend
REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000
